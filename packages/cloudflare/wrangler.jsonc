{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "n8n",
	"main": "dist/worker/index.js",
	"base_dir": "dist/worker",
	"no_bundle": true,
	"find_additional_modules": true,
	"rules": [{ "type": "ESModule", "globs": ["**/*.js"] }],
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": { "crons": ["*/15 * * * *"] },
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"worker_loaders": [{ "binding": "LOADER" }],
	"limits": { "cpu_ms": 300000 },
	"observability": { "enabled": true },
	"placement": { "mode": "smart" },
	"upload_source_maps": false,
	"assets": {
		"directory": "dist/assets",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/rest/*",
			"/webhook/*",
			"/webhook-test/*",
			"/webhook-waiting/*",
			"/form/*",
			"/form-test/*",
			"/form-waiting/*",
			"/healthz"
		]
	},
	"vars": {
		"N8N_USER_FOLDER": "/tmp",
		"N8N_DIAGNOSTICS_ENABLED": "false",
		"N8N_VERSION_NOTIFICATIONS_ENABLED": "false",
		"N8N_TEMPLATES_ENABLED": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "n8n",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "STORAGE", "bucket_name": "n8n-storage" }],
	"durable_objects": {
		"bindings": [
			{ "name": "PUSH", "class_name": "PushHub" },
			{ "name": "TRIGGERS", "class_name": "TriggerScheduler" },
			{ "name": "TRIGGER_CONNECTIONS", "class_name": "TriggerConnection" },
			{ "name": "RUNNER", "class_name": "ExecutionRunner" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PushHub", "TriggerScheduler"] },
		{ "tag": "v2", "new_sqlite_classes": ["ExecutionRunner"] },
		{ "tag": "v3", "new_sqlite_classes": ["TriggerConnection"] }
	],
	"ratelimits": [
		{ "name": "LOGIN_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 200, "period": 60 } },
		{ "name": "LOGIN_EMAIL_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
		{ "name": "PASSWORD_USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
	],
	"workflows": [
		{ "name": "n8n-executions", "binding": "EXECUTIONS", "class_name": "ExecutionWorkflow" }
	]
}
